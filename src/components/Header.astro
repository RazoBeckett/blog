---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-[100] border-b border-border bg-[#fffdf7]/90 backdrop-blur-sm transition-colors duration-300 [[data-theme=dark]_&]:bg-[#1a1a1c]/90">
	<nav class="mx-auto flex max-w-[900px] items-center justify-between gap-6 px-6 py-5 max-[720px]:px-5 max-[720px]:py-4">
		<a href="/" class="relative z-[102] flex items-center gap-2 text-[20px] font-bold leading-[1.6] tracking-[-0.02em] text-text-primary no-underline transition-colors duration-150">
			{SITE_TITLE}
		</a>
		
		<button class="relative z-[102] hidden h-10 w-10 cursor-pointer flex-col items-center justify-center gap-[5px] border-0 bg-transparent p-0 max-[720px]:flex" id="mobile-menu-btn" type="button" aria-label="Toggle menu" aria-expanded="false">
			<span class="block h-0.5 w-[22px] rounded-sm bg-text-primary transition-all duration-300" id="line1"></span>
			<span class="block h-0.5 w-[22px] rounded-sm bg-text-primary transition-all duration-300" id="line2"></span>
			<span class="block h-0.5 w-[22px] rounded-sm bg-text-primary transition-all duration-300" id="line3"></span>
		</button>
		
		<div class="flex items-center gap-6 max-[720px]:hidden" id="nav-right">
			<div class="flex items-center gap-2">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
			</div>
			<ThemeToggle />
		</div>
	</nav>
	
	<div class="fixed inset-0 z-[101] h-screen w-screen bg-[#fffdf7] opacity-0 invisible transition-all duration-300 min-[721px]:hidden [[data-theme=dark]_&]:bg-[#1a1a1c]" id="mobile-menu-overlay">
		<div class="flex h-full flex-col items-center justify-center gap-6 p-8">
			<a href="/" class="px-4 py-2 text-[28px] font-semibold leading-[1.6] text-text-primary no-underline transition-colors duration-200 hover:text-accent">Home</a>
			<a href="/blog" class="px-4 py-2 text-[28px] font-semibold leading-[1.6] text-text-primary no-underline transition-colors duration-200 hover:text-accent">Blog</a>
			<a href="/about" class="px-4 py-2 text-[28px] font-semibold leading-[1.6] text-text-primary no-underline transition-colors duration-200 hover:text-accent">About</a>
			<div class="mt-4">
				<ThemeToggle />
			</div>
		</div>
	</div>
</header>

<script>
	function initMobileMenu() {
		const btn = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
		const overlay = document.getElementById('mobile-menu-overlay') as HTMLDivElement | null;
		const line1 = document.getElementById('line1') as HTMLSpanElement | null;
		const line2 = document.getElementById('line2') as HTMLSpanElement | null;
		const line3 = document.getElementById('line3') as HTMLSpanElement | null;
		
		if (!btn || !overlay || !line1 || !line2 || !line3) return;
		
		let isOpen = false;
		
		const openMenu = () => {
			isOpen = true;
			overlay.classList.remove('opacity-0', 'invisible');
			overlay.classList.add('opacity-100', 'visible');
			btn.setAttribute('aria-expanded', 'true');
			document.body.style.overflow = 'hidden';
			line1.style.transform = 'translateY(7px) rotate(45deg)';
			line2.style.opacity = '0';
			line3.style.transform = 'translateY(-7px) rotate(-45deg)';
		};
		
		const closeMenu = () => {
			isOpen = false;
			overlay.classList.add('opacity-0', 'invisible');
			overlay.classList.remove('opacity-100', 'visible');
			btn.setAttribute('aria-expanded', 'false');
			document.body.style.overflow = '';
			line1.style.transform = '';
			line2.style.opacity = '';
			line3.style.transform = '';
		};
		
		btn.addEventListener('click', () => {
			if (isOpen) closeMenu();
			else openMenu();
		});
		
		overlay.querySelectorAll('a').forEach(link => {
			link.addEventListener('click', closeMenu);
		});
		
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && isOpen) closeMenu();
		});
	}
	
	initMobileMenu();
	document.addEventListener('astro:after-swap', initMobileMenu);
</script>
