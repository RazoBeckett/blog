<button class="theme-toggle cursor-pointer border-0 bg-transparent p-0 text-text-primary" type="button" aria-label="Toggle dark mode">
  <div class="h-[26px] w-12 rounded-pill border border-border bg-bg-tertiary transition-colors duration-300 hover:border-border-strong">
    <div class="relative top-0.5 left-0.5 flex h-5 w-5 items-center justify-center rounded-full bg-surface text-text-secondary shadow-sm transition-transform duration-300 [[data-theme=dark]_&]:translate-x-[22px] [[data-theme=dark]_&]:bg-text-primary [[data-theme=dark]_&]:text-bg">
      <svg class="absolute opacity-100 transition-all duration-150 [[data-theme=dark]_&]:scale-50 [[data-theme=dark]_&]:opacity-0" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
      <svg class="absolute scale-50 opacity-0 transition-all duration-150 [[data-theme=dark]_&]:scale-100 [[data-theme=dark]_&]:opacity-100" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </div>
  </div>
</button>

<script>
  function initTheme() {
    const toggles = document.querySelectorAll('.theme-toggle');
    if (toggles.length === 0) return;

    const getTheme = (): string => {
      const stored = localStorage.getItem('theme');
      if (stored) return stored;
      return 'dark';
    };

    const setTheme = (theme: string) => {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('theme', theme);
    };

    toggles.forEach(toggle => {
      toggle.addEventListener('click', () => {
        document.body.classList.add('theme-transition');
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        setTheme(next);
        setTimeout(() => document.body.classList.remove('theme-transition'), 300);
      });
    });

    setTheme(getTheme());
  }

  initTheme();
  document.addEventListener('astro:after-swap', initTheme);
</script>
